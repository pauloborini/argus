{
  "name": "argus",
  "version": "2.1.0",
  "private": true,
  "description": "Argus — motor local de code retrieval e context packing para agentes",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=argus",
    "benchmark:mvp": "npm run benchmark:mvp --workspace=argus",
    "test": "npm run test --workspace=argus",
    "lint": "npm run lint --workspace=argus",
    "typecheck": "npm run typecheck --workspace=argus",
    "validate": "npm run typecheck && npm test && npm run lint && npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "homologate": "npm run build && node scripts/homologate.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:eval": "npm run build && node scripts/release-evaluation.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}