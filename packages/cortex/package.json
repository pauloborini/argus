{
  "name": "atlas-cortex",
  "version": "1.0.1",
  "description": "Local code retrieval and context packing for coding agents",
  "license": "MIT",
  "author": "Paulo Borini",
  "homepage": "https://github.com/pauloborini/atlas-cortex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pauloborini/atlas-cortex.git"
  },
  "bugs": {
    "url": "https://github.com/pauloborini/atlas-cortex/issues"
  },
  "keywords": [
    "mcp",
    "code-retrieval",
    "context-packing",
    "coding-agents",
    "static-analysis"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atlas-cortex": "./dist/cli.js",
    "cortex": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark:mvp": "node ./dist/benchmark/run-mvp.js ../..",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@parcel/watcher": "^2.5.6",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.5",
    "tree-sitter": "^0.22.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.24.4",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "protobufjs": "^7.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "protobufjs": "^7.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
